<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="Authentication" id="1775900481832-0">
        <addColumn tableName="db_mgr_user">
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="Authentication" id="1775900481832-6">
        <preConditions onFail="CONTINUE">
            <foreignKeyConstraintExists foreignKeyName="FK_address_user" />
        </preConditions>
        <dropForeignKeyConstraint baseTableName="db_mgr_address" constraintName="FK_address_user"/>
    </changeSet>

    <changeSet author="Authentication" id="1775900481832-7">
        <preConditions onFail="CONTINUE">
            <foreignKeyConstraintExists foreignKeyName="FK_user_account" />
        </preConditions>
        <dropForeignKeyConstraint baseTableName="db_mgr_user" constraintName="FK_user_account"/>
    </changeSet>

    <changeSet author="Authentication" id="1775900481832-1">
        <preConditions onFail="CONTINUE">
            <primaryKeyExists tableName="db_mgr_user"/>
        </preConditions>
        <dropPrimaryKey tableName="db_mgr_user"/>
    </changeSet>

    <changeSet author="Authentication" id="1775900481832-14">
        <dropColumn columnName="id" tableName="db_mgr_user"/>
    </changeSet>

    <changeSet author="Authentication" id="1775900481832-2">
        <addPrimaryKey columnNames="account_id" constraintName="db_mgr_userPK" tableName="db_mgr_user"/>
    </changeSet>

    <changeSet author="Authentication" id="1775900481832-4">
        <addForeignKeyConstraint baseColumnNames="account_id"
                                 baseTableName="db_mgr_user"
                                 constraintName="FK_user_account_new"
                                 referencedColumnNames="id"
                                 referencedTableName="db_mgr_account"/>
    </changeSet>

    <changeSet author="Authentication" id="1775900481832-5">
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="db_mgr_address"
                                 constraintName="FK_address_user_new"
                                 referencedColumnNames="account_id"
                                 referencedTableName="db_mgr_user"/>
    </changeSet>
</databaseChangeLog>
